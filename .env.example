# Salin ke .env.local dan isi nilainya. Jangan pernah commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://wvupuzjytvbogxauoqxu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio
GEMINI_API_KEY=

# 9router (OpenAI-compatible), mis. https://<host-9router>/v1
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Model per tugas (ADR-003). Nama model 9router sesuai dashboard 9router Anda.
CHAT_MODEL=
GRADER_MODEL=
LIVE_MODEL=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Login Google (M1): "true" hanya setelah Google OAuth Client diisi di Supabase > Authentication > Providers
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
